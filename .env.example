# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed app (when applicable).
APP_URL="MY_APP_URL"

# Required for Android install/launch/uninstall/session-control endpoints.
# Generate a fresh secret, for example: openssl rand -hex 32
# The app refuses control operations if this is unset or shorter than 32 characters.
ANDROID_CONTROL_TOKEN=""

# Arclight client: configure these only in the Arclight application server.
# Point to an authenticated HTTPS reverse proxy/tunnel for the external host agent.
ANDROID_HOST_AGENT_URL=""
ANDROID_HOST_AGENT_CLIENT_TOKEN=""

# External Android host agent: use a separate environment on the supported host.
# Keep the agent bound to loopback by default; expose it remotely only via a TLS proxy/tunnel.
ANDROID_HOST_AGENT_TOKEN=""
ANDROID_HOST_AGENT_HOST="127.0.0.1"
ANDROID_HOST_AGENT_PORT="4317"
